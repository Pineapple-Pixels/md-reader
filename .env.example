PORT=3500

# Raiz unica de storage. Dentro vive: orgs/<org>/{users/<id>/, teams/<slug>/, public/}
STORAGE_DIR=./storage

# Seed inicial — solo se usa si la tabla users esta vacia al arrancar.
# Despues de bootear la DB, gestiona users con `npm run user:create`.
ADMIN_USER=admin
ADMIN_PASS=change-me

# Generar con: openssl rand -base64 64
JWT_SECRET=change-me-in-production

# PostgreSQL. Para dev con docker-compose usar el servicio local:
DATABASE_URL=postgres://mdreader:mdreader@localhost:5432/mdreader

# Login con Google (opcional; sin las tres no aparece el boton).
# Redirect URI a registrar en Google Cloud: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=http://localhost:3500

# Tests de integracion (opcional): servidor Postgres con permiso CREATEDB; el test crea y borra su propia base.
# TEST_DATABASE_URL=postgres://user:pass@localhost:5432/postgres

# Tests e2e (Playwright): servidor Postgres con permiso CREATEDB; por defecto el descartable del puerto 5433.
# E2E_DATABASE_URL=postgres://mdreader:mdreader@localhost:5433/postgres
